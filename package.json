{
  "name": "radiology-lab-system",
  "version": "1.0.0",
  "description": "Radiology Lab Management System MVP",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "services": "powershell -ExecutionPolicy Bypass -File ./scripts/start-services.ps1",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
